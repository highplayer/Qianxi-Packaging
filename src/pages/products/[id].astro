---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/i18n/utils';
import pricing3Layer from '@data/pricing/3-layer.json';
import pricing5Layer from '@data/pricing/5-layer.json';
import pricing7Layer from '@data/pricing/7-layer.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pricingBySlug: Record<string, typeof pricing3Layer> = {
  '3-layer': pricing3Layer,
  '5-layer': pricing5Layer,
  '7-layer': pricing7Layer,
};

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => p.id.startsWith('en/'))
    .map(p => ({ params: { id: p.id.replace(/^en\//, '') }, props: { product: p } }));
}

const { product } = Astro.props;
const t = getTranslations('en');
const { data } = product;
const pricing = pricingBySlug[product.id.replace(/^en\//, '')];
---

<MainLayout>
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <!-- Header -->
      <div class="mb-12 max-w-3xl">
        <h1 class="mb-4 text-4xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">{data.title}</h1>
        <p class="text-lg leading-relaxed text-gray-600">{data.main.content}</p>
      </div>

      <!-- Price list: rows = sizes, columns = quantity tiers -->
      {pricing && (
        <div class="rounded-xl border border-gray-200 bg-white p-6 sm:p-8">
          <h2 class="mb-6 text-2xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
            {t.products.priceListTitle}
          </h2>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[640px] border-collapse text-sm">
              <thead>
                <tr class="bg-primary-900 text-white">
                  <th class="px-4 py-3 text-left font-semibold whitespace-nowrap">{t.products.tableSize}</th>
                  <th class="px-4 py-3 text-left font-semibold whitespace-nowrap">{t.products.tableQuality}</th>
                  {pricing.tiers.map(tier => (
                    <th class="px-4 py-3 text-right font-semibold whitespace-nowrap">{tier.en}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {pricing.rows.map((row, i) => (
                  <tr class={i % 2 === 1 ? 'bg-gray-50' : ''}>
                    <td class="px-4 py-3 font-medium text-primary-800 whitespace-nowrap">{row.size}</td>
                    <td class="px-4 py-3 text-gray-600 whitespace-nowrap">{row.quality}</td>
                    {row.prices.map(price => (
                      <td class="px-4 py-3 text-right font-semibold text-gray-800 whitespace-nowrap">
                        {pricing.currency} {price}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="mt-4 text-xs text-gray-500">{t.products.pricingNote}</p>
        </div>
      )}

      <!-- Applications + Custom Options -->
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{t.products.detailApplications}</h3>
          <ul class="space-y-2">
            {data.applications.map(app => (
              <li class="flex items-start gap-2 text-gray-600"><span class="text-accent-600 mt-1">•</span> {app}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{t.products.detailCustomOptions}</h3>
          <ul class="space-y-2">
            {data.customOptions.map(opt => (
              <li class="flex items-start gap-2 text-gray-600"><span class="text-accent-600 mt-1">•</span> {opt}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a href={`${base}/quote`} class="inline-block rounded-lg bg-accent-600 px-8 py-3.5 font-semibold text-white transition hover:bg-accent-700">
          {t.products.detailRequestQuote} →
        </a>
      </div>
    </div>
  </section>
</MainLayout>
