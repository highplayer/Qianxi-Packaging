---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/i18n/utils';
import { blankAreaM2, pricePerPiece, formatPrice } from '@utils/boxPricing';
import pricing3Layer from '@data/pricing/3-layer.json';
import pricing5Layer from '@data/pricing/5-layer.json';
import pricing7Layer from '@data/pricing/7-layer.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pricingBySlug: Record<string, typeof pricing3Layer> = {
  '3-layer': pricing3Layer,
  '5-layer': pricing5Layer,
  '7-layer': pricing7Layer,
};

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => p.id.startsWith('en/'))
    .map(p => ({ params: { id: p.id.replace(/^en\//, '') }, props: { product: p } }));
}

const { product } = Astro.props;
const t = getTranslations('en');
const { data } = product;
const slug = product.id.replace(/^en\//, '');
const pricing = pricingBySlug[slug];
const layerNum = slug.charAt(0);
const quoteUrl = `${base}/quote?layer=${layerNum}`;

// Pricing parameters (see src/utils/boxPricing.ts)
const params = {
  jointMm: pricing?.jointMm ?? 38,
  yieldRate: pricing?.yieldRate ?? 0.85,
  processPerPiece: pricing?.processPerPiece ?? 0.055,
  marginRate: pricing?.marginRate ?? 0.12,
  referenceGrammage: pricing?.referenceGrammage ?? 150,
};

const priceCell = (rate: number, dims: number[], factor: number) => {
  const area = blankAreaM2(dims, params.jointMm);
  const value = pricePerPiece({
    areaM2: area,
    ratePerM2: rate,
    grammage: params.referenceGrammage,
    tierFactor: factor,
    params,
  });
  return formatPrice(value, pricing?.currency ?? 'EUR');
};
---

<MainLayout>
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <!-- Header -->
      <div class="mb-8 max-w-3xl">
        <h1 class="mb-4 text-4xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">{data.title}</h1>
        <p class="text-lg leading-relaxed text-gray-600">{data.main.content}</p>
      </div>

      <!-- Prominent notices: placed before the type nav so nobody can skip them -->
      {pricing && (
        <div class="mb-8 rounded-xl border-2 border-amber-300 bg-amber-50 p-5">
          <p class="mb-3 flex items-center gap-2 text-base font-bold text-amber-900" style="font-family: var(--font-heading);">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
            {t.products.noticeTitle}
          </p>
          <ul class="space-y-2 text-sm leading-relaxed text-amber-900">
            <li class="flex gap-2"><span class="font-bold">•</span><span>{t.products.sizeNotice}</span></li>
            <li class="flex gap-2"><span class="font-bold">•</span><span>{t.products.regionNotice}</span></li>
            <li class="flex gap-2"><span class="font-bold">•</span><span>{t.products.areaNotice}</span></li>
          </ul>
        </div>
      )}

      <!-- Type jump navigation -->
      {pricing && (
        <div class="mb-10 flex flex-wrap items-center gap-2 border-y border-gray-200 py-4">
          <span class="mr-1 text-sm font-medium text-gray-500">{t.products.typeNavLabel}</span>
          {pricing.types.map(type => (
            <a
              href={`#type-${type.code}`}
              class="rounded-full border border-gray-300 px-3.5 py-1 text-sm font-semibold text-gray-700 transition hover:border-accent-600 hover:text-accent-600"
            >
              {type.code}
            </a>
          ))}
        </div>
      )}

      <!-- Price lists: one table per flute type, grammage switchable from the header -->
      {pricing && (
        <div
          id="pricing-root"
          class="rounded-xl border border-gray-200 bg-white p-6 sm:p-8"
          data-cur={pricing.currency}
          data-unit={t.products.grammageUnit}
          data-gref={params.referenceGrammage}
          data-presets={pricing.grammagePresets.join(',')}
          data-min={pricing.grammageRange.min}
          data-max={pricing.grammageRange.max}
          data-step={pricing.grammageRange.step}
          data-joint={params.jointMm}
          data-yield={params.yieldRate}
          data-process={params.processPerPiece}
          data-margin={params.marginRate}
        >
          <h2 class="mb-6 text-2xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
            {t.products.priceListTitle}
          </h2>

          {pricing.types.map(type => (
            <div class="mb-10 last:mb-0">
              <h3
                id={`type-${type.code}`}
                class="mb-3 scroll-mt-24 text-lg font-bold text-primary-800"
                style="font-family: var(--font-heading);"
              >
                {t.products.tableType} {type.code}
              </h3>
              <p class="mb-2 text-xs font-medium text-amber-800">{t.products.tableNotice}</p>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[720px] border-collapse text-sm">
                  <thead>
                    <tr class="bg-primary-900 text-white">
                      <th class="px-4 py-3 text-left font-semibold whitespace-nowrap">{t.products.tableSize}</th>
                      <th class="px-4 py-2.5 text-left font-semibold whitespace-nowrap">
                        <div class="flex items-center gap-2">
                          <span>{t.products.tableGrammage}</span>
                          <button
                            type="button"
                            class="grammage-trigger inline-flex items-center gap-1 rounded-md border border-white/40 px-2 py-0.5 text-xs font-semibold transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white"
                            aria-expanded="false"
                            aria-haspopup="dialog"
                          >
                            <span class="grammage-value">{params.referenceGrammage}</span>
                            <span>{t.products.grammageUnit}</span>
                            <span aria-hidden="true">▾</span>
                          </button>
                        </div>
                      </th>
                      {pricing.tiers.map(tier => (
                        <th class="px-4 py-3 text-right font-semibold whitespace-nowrap">{tier.en}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {type.rows.map((row, i) => (
                      <tr data-dims={row.dims.join(',')} data-rate={type.ratePerM2} class={i % 2 === 1 ? 'bg-gray-50' : ''}>
                        <td class="px-4 py-3 font-medium text-primary-800 whitespace-nowrap">{row.size}</td>
                        <td class="grammage-cell px-4 py-3 text-gray-600 whitespace-nowrap">
                          {params.referenceGrammage} {t.products.grammageUnit}
                        </td>
                        {pricing.tiers.map(tier => (
                          <td class="price-cell px-4 py-3 text-right font-semibold text-gray-800 whitespace-nowrap" data-factor={tier.factor}>
                            {priceCell(type.ratePerM2, row.dims, tier.factor)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}

          <p class="mt-4 text-xs text-gray-500">{t.products.pricingNote}</p>

          <!-- Grammage picker (fixed-position so the table's overflow container cannot clip it) -->
          <div
            id="grammage-panel"
            class="fixed z-50 hidden w-72 rounded-xl border border-gray-200 bg-white p-4 shadow-2xl"
            role="dialog"
            aria-label={t.products.tableGrammage}
          >
            <p class="mb-2 text-xs font-semibold text-gray-600">{t.products.grammagePresetsLabel}</p>
            <div id="grammage-presets" class="mb-4 flex flex-wrap gap-2"></div>
            <p class="mb-1 text-xs font-semibold text-gray-600">{t.products.grammageCustomLabel}</p>
            <div class="flex items-center gap-2">
              <input
                id="grammage-input"
                type="number"
                min={pricing.grammageRange.min}
                max={pricing.grammageRange.max}
                step={pricing.grammageRange.step}
                class="w-full rounded-lg border-gray-300 px-3 py-1.5 text-sm focus:border-primary-500 focus:ring-primary-500"
              />
              <span class="shrink-0 text-xs text-gray-500">{t.products.grammageUnit}</span>
            </div>
            <p id="grammage-error" class="mt-1 hidden text-xs text-red-600">{t.products.grammageInvalid}</p>
            <div class="mt-3 flex justify-end gap-2">
              <button type="button" id="grammage-cancel" class="rounded-lg px-3 py-1.5 text-xs font-semibold text-gray-600 transition hover:bg-gray-100">
                {t.products.grammageCancel}
              </button>
              <button type="button" id="grammage-apply" class="rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-accent-700">
                {t.products.grammageApply}
              </button>
            </div>
          </div>
        </div>
      )}

      <!-- Applications + Custom Options -->
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{t.products.detailApplications}</h3>
          <ul class="space-y-2">
            {data.applications.map(app => (
              <li class="flex items-start gap-2 text-gray-600"><span class="text-accent-600 mt-1">•</span> {app}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{t.products.detailCustomOptions}</h3>
          <ul class="space-y-2">
            {data.customOptions.map(opt => (
              <li class="flex items-start gap-2 text-gray-600"><span class="text-accent-600 mt-1">•</span> {opt}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a href={quoteUrl} class="inline-block rounded-lg bg-accent-600 px-8 py-3.5 font-semibold text-white transition hover:bg-accent-700">
          {t.products.detailRequestQuote} →
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { blankAreaM2, pricePerPiece, formatPrice } from '@utils/boxPricing';

  const root = document.getElementById('pricing-root') as HTMLElement | null;
  if (root) {
    const currency = root.dataset.cur || 'EUR';
    const unit = root.dataset.unit || 'g/m²';
    const gref = Number(root.dataset.gref || 150);
    const presets = (root.dataset.presets || '')
      .split(',')
      .map(Number)
      .filter(n => n > 0);
    const min = Number(root.dataset.min || 80);
    const max = Number(root.dataset.max || 300);
    const step = Number(root.dataset.step || 5);
    const params = {
      jointMm: Number(root.dataset.joint || 38),
      yieldRate: Number(root.dataset.yield || 0.85),
      processPerPiece: Number(root.dataset.process || 0.055),
      marginRate: Number(root.dataset.margin || 0.12),
      referenceGrammage: gref,
    };

    let current = gref;

    const panel = document.getElementById('grammage-panel');
    const presetsBox = document.getElementById('grammage-presets');
    const input = document.getElementById('grammage-input') as HTMLInputElement | null;
    const errorEl = document.getElementById('grammage-error');
    const applyBtn = document.getElementById('grammage-apply');
    const cancelBtn = document.getElementById('grammage-cancel');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('.grammage-trigger'));

    function render(grammage: number) {
      root!.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach(tr => {
        const dims = (tr.dataset.dims || '').split(',').map(Number);
        const rate = Number(tr.dataset.rate || 0);
        const area = blankAreaM2(dims, params.jointMm);
        tr.querySelectorAll<HTMLTableCellElement>('.price-cell').forEach(td => {
          const factor = Number(td.dataset.factor || 1);
          const value = pricePerPiece({ areaM2: area, ratePerM2: rate, grammage, tierFactor: factor, params });
          td.textContent = formatPrice(value, currency);
        });
        const cell = tr.querySelector<HTMLElement>('.grammage-cell');
        if (cell) cell.textContent = `${grammage} ${unit}`;
      });
      root!.querySelectorAll<HTMLElement>('.grammage-value').forEach(el => {
        el.textContent = String(grammage);
      });
      presetsBox?.querySelectorAll<HTMLButtonElement>('button').forEach(btn => {
        const active = Number(btn.dataset.g) === grammage;
        btn.classList.toggle('bg-accent-600', active);
        btn.classList.toggle('border-accent-600', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('bg-white', !active);
        btn.classList.toggle('border-gray-300', !active);
        btn.classList.toggle('text-gray-700', !active);
      });
    }

    function openPanel(trigger: HTMLButtonElement) {
      if (!panel) return;
      panel.classList.remove('hidden');
      if (input) input.value = String(current);
      errorEl?.classList.add('hidden');
      const rect = trigger.getBoundingClientRect();
      const pw = panel.offsetWidth || 288;
      const ph = panel.offsetHeight || 220;
      const left = Math.max(12, Math.min(rect.left, window.innerWidth - pw - 12));
      let top = rect.bottom + 8;
      if (top + ph > window.innerHeight - 12) top = Math.max(12, rect.top - ph - 8);
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      trigger.setAttribute('aria-expanded', 'true');
      input?.focus();
      input?.select();
    }

    function closePanel() {
      panel?.classList.add('hidden');
      triggers.forEach(tr => tr.setAttribute('aria-expanded', 'false'));
    }

    function apply(value: number) {
      current = value;
      render(current);
      closePanel();
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        openPanel(btn);
      });
    });

    presets.forEach(p => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.g = String(p);
      btn.textContent = `${p} ${unit}`;
      btn.className = 'rounded-full border px-3 py-1 text-xs font-semibold transition';
      btn.addEventListener('click', () => apply(p));
      presetsBox?.appendChild(btn);
    });

    applyBtn?.addEventListener('click', () => {
      const raw = Number(input?.value);
      const value = Math.round(raw / step) * step;
      if (!Number.isFinite(value) || value < min || value > max) {
        errorEl?.classList.remove('hidden');
        return;
      }
      apply(value);
    });

    cancelBtn?.addEventListener('click', closePanel);

    document.addEventListener('click', e => {
      if (!panel || panel.classList.contains('hidden')) return;
      const target = e.target as Node;
      if (panel.contains(target) || triggers.some(tr => tr.contains(target))) return;
      closePanel();
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closePanel();
    });

    window.addEventListener('resize', closePanel);

    render(current);
  }
</script>
