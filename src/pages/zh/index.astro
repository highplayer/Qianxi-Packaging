---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/home/HeroSection.astro';
import WhyChooseUs from '@components/sections/home/WhyChooseUs.astro';
import ProductShowcase from '@components/sections/home/ProductShowcase.astro';
import FscCert from '@components/sections/misc/FscCert.astro';
import IndustriesWeServe from '@components/sections/home/IndustriesWeServe.astro';
import FactorySnapshot from '@components/sections/home/FactorySnapshot.astro';
import ProductionLine from '@components/sections/home/ProductionLine.astro';
import QualityControl from '@components/sections/home/QualityControl.astro';
import CustomProcess from '@components/sections/home/CustomProcess.astro';
import CTASection from '@components/sections/home/CTASection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import { getTranslations } from '@/i18n/utils';
import allFaqs from '@data/faqs.zh.json';

const t = getTranslations('zh');
---

<MainLayout lang="zh">
  <HeroSection t={t} lang="zh" />
  <ProductShowcase t={t} lang="zh" />
  <WhyChooseUs t={t} />
  <FscCert lang="zh" variant="compact" />
  <IndustriesWeServe lang="zh" />
  <FactorySnapshot t={t} lang="zh" />
  <ProductionLine lang="zh" />
  <QualityControl lang="zh" />
  <CustomProcess lang="zh" />
  <CTASection t={t} lang="zh" />
  <FAQ title={t.home.faqTitle} faqs={allFaqs} />
</MainLayout>
