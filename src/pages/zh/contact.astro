---
import MainLayout from '@/layouts/MainLayout.astro';
import ContactInfo from '@components/sections/contact/ContactInfo.astro';
import { getTranslations } from '@/i18n/utils';

const t = getTranslations('zh');
---

<MainLayout lang="zh">
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <h1 class="mb-4 text-center text-4xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
        {t.contactPage.title}
      </h1>
      <p class="mb-12 text-center text-lg text-gray-600">{t.contactPage.subtitle}</p>
      <ContactInfo t={t} lang="zh" />
    </div>
  </section>
</MainLayout>
