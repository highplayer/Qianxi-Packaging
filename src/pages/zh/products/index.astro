---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/i18n/utils';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = getTranslations('zh');
const allProducts = await getCollection('products');
const products = allProducts.filter(p => p.id.startsWith('zh/'));
---

<MainLayout lang="zh">
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <h1 class="mb-12 text-center text-4xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
        {t.products.listTitle}
      </h1>
      <div class="grid gap-8 md:grid-cols-2">
        {products.map(product => (
          <a
            href={`${base}/zh/products/${product.id.replace(/^zh\//, '')}`}
            class="group rounded-xl border border-gray-200 bg-white p-8 shadow-sm transition hover:shadow-md"
          >
            <h2 class="mb-2 text-2xl font-bold text-primary-800 transition group-hover:text-accent-600" style="font-family: var(--font-heading);">
              {product.data.title}
            </h2>
            <p class="mb-4 text-gray-600">{product.data.description}</p>
            <div class="mb-6 flex flex-wrap gap-2 text-xs">
              <span class="rounded-full bg-gray-100 px-2 py-1 text-gray-600">{product.data.specs.fluteType}</span>
              <span class="rounded-full bg-gray-100 px-2 py-1 text-gray-600">{product.data.specs.moq}</span>
            </div>
            <span class="font-semibold text-accent-600">{t.products.viewPriceList} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</MainLayout>
