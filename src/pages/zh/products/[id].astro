---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/i18n/utils';
import { pricePerPiece, formatPrice, type PricingParams, type PricingMode, type ModeConfig } from '@utils/boxPricing';
import materials from '@data/pricing/materials.json';
import pricing3Layer from '@data/pricing/3-layer.json';
import pricing5Layer from '@data/pricing/5-layer.json';
import pricing7Layer from '@data/pricing/7-layer.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const LANG: string = 'zh';

const pricingBySlug: Record<string, typeof pricing3Layer> = {
  '3-layer': pricing3Layer,
  '5-layer': pricing5Layer,
  '7-layer': pricing7Layer,
};

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products
    .filter(p => p.id.startsWith('zh/'))
    .map(p => ({ params: { id: p.id.replace(/^zh\//, '') }, props: { product: p } }));
}

const { product } = Astro.props;
const t = getTranslations('zh');
const { data } = product;
const slug = product.id.replace(/^zh\//, '');
const pricing = pricingBySlug[slug];
const layerCount = slug.charAt(0);
const quoteUrl = `${base}/zh/quote?layer=${layerCount}`;

const params: PricingParams = {
  jointMm: pricing?.jointMm ?? 38,
  yieldRate: pricing?.yieldRate ?? 0.85,
  otherCostFactor: pricing?.otherCostFactor ?? 1.25,
  cnyToEur: pricing?.cnyToEur ?? 0.128,
  eurPerUsd: pricing?.eurPerUsd ?? 0.93,
  container: pricing?.container ?? { costUsd: 9500, volumeM3: 76, fillRate: 0.85 },
  customsPerBox: pricing?.customsPerBox ?? 0,
  agentFeeRate: pricing?.agentFeeRate ?? 0.015,
  boardThicknessMm: (pricing?.boardThicknessMm ?? { '3': 3, '5': 7, '7': 11 }) as Record<string, number>,
  modes: (pricing?.modes ?? {
    delivered: { freight: true, customs: true, agentFee: true, margin: 0.25 },
    exw: { freight: false, customs: false, agentFee: false, margin: 0.3 },
  }) as Record<PricingMode, ModeConfig>,
};

type Liner = { id: string; zh: string; en: string; price: number };
type Medium = { id: string; zh: string; en: string; prices: Record<string, number> };

const liners = materials.liners as Liner[];
const mediums = materials.mediums as Medium[];
const boardProcessing = materials.boardProcessing as Record<string, number>;
const smallOrder = materials.smallOrder as { under150: Record<string, number>; under300: Record<string, number> };

const processing = boardProcessing[layerCount] ?? 0.28;
const presets = pricing?.materialPresets ?? [];
const defaultPreset = presets.find(p => p.id === pricing?.defaultPreset) ?? presets[0];
const defaultLinerId = defaultPreset?.liner ?? liners[0].id;
const defaultMediumId = defaultPreset?.medium ?? mediums[0].id;
const defaultLiner = liners.find(l => l.id === defaultLinerId) ?? liners[0];
const defaultMedium = mediums.find(m => m.id === defaultMediumId) ?? mediums[0];
const defaultMode: PricingMode = (pricing?.defaultMode as PricingMode) ?? 'delivered';
const currency = pricing?.currency ?? 'EUR';

const nameOf = (item: { zh: string; en: string }) => (LANG === 'zh' ? item.zh : item.en);
const materialLabel = (fluteCount: number) =>
  `${nameOf(defaultLiner)} × ${fluteCount + 1} + ${nameOf(defaultMedium)}`;

const priceFor = (typeCode: string, dims: number[], qty: number, mode: PricingMode) =>
  pricePerPiece({
    dims,
    typeCode,
    layerCount,
    linerPrice: defaultLiner.price,
    mediumPrices: defaultMedium.prices,
    processing,
    smallOrder,
    qty,
    mode,
    params,
  });
---

<MainLayout lang="zh">
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <!-- 页头 -->
      <div class="mb-8 max-w-3xl">
        <h1 class="mb-4 text-4xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">{data.title}</h1>
        <p class="text-lg leading-relaxed text-gray-600">{data.main.content}</p>
      </div>

      <!-- 醒目提示：放在楞型导航之前 -->
      {pricing && (
        <div class="mb-8 rounded-xl border-2 border-amber-300 bg-amber-50 p-5">
          <p class="mb-3 flex items-center gap-2 text-base font-bold text-amber-900" style="font-family: var(--font-heading);">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
            </svg>
            {t.products.noticeTitle}
          </p>
          <ul class="space-y-2 text-sm leading-relaxed text-amber-900">
            <li class="flex gap-2"><span class="font-bold">•</span><span>{t.products.sizeNotice}</span></li>
            <li class="flex gap-2">
              <span class="font-bold">•</span>
              <span>
                <span data-mode-notice="delivered">{t.products.regionNotice}</span>
                <span data-mode-notice="exw" class="hidden">{t.products.regionNoticeExw}</span>
              </span>
            </li>
            <li class="flex gap-2"><span class="font-bold">•</span><span>{t.products.areaNotice}</span></li>
          </ul>
        </div>
      )}

      <!-- 报价方式切换 -->
      {pricing && pricing.types.length > 0 && (
        <div class="mb-6 flex flex-wrap items-center gap-3">
          <span class="text-sm font-semibold text-gray-600">{t.products.modeLabel}</span>
          <div class="inline-flex overflow-hidden rounded-lg border border-gray-300">
            <button type="button" data-mode-btn="delivered" class="mode-btn px-4 py-2 text-sm font-semibold transition bg-accent-600 text-white">
              {t.products.modeDelivered}
            </button>
            <button type="button" data-mode-btn="exw" class="mode-btn px-4 py-2 text-sm font-semibold transition bg-white text-gray-700 hover:bg-gray-50">
              {t.products.modeExw}
            </button>
          </div>
        </div>
      )}

      <!-- 楞型跳转导航 -->
      {pricing && pricing.types.length > 0 && (
        <div class="mb-10 flex flex-wrap items-center gap-2 border-y border-gray-200 py-4">
          <span class="mr-1 text-sm font-medium text-gray-500">{t.products.typeNavLabel}</span>
          {pricing.types.map(type => (
            <a
              href={`#type-${type.code}`}
              class="rounded-full border border-gray-300 px-3.5 py-1 text-sm font-semibold text-gray-700 transition hover:border-accent-600 hover:text-accent-600"
            >
              {type.code}
            </a>
          ))}
        </div>
      )}

      <!-- 价目表 -->
      {pricing && pricing.types.length > 0 && (
        <div id="pricing-root" class="rounded-xl border border-gray-200 bg-white p-6 sm:p-8">
          <h2 class="mb-6 text-2xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
            {t.products.priceListTitle}
          </h2>

          {pricing.types.map(type => (
            <div class="mb-10 last:mb-0" data-type={type.code}>
              <h3
                id={`type-${type.code}`}
                class="mb-3 scroll-mt-24 text-lg font-bold text-primary-800"
                style="font-family: var(--font-heading);"
              >
                {t.products.tableType} {type.code}
              </h3>
              <p class="mb-2 text-xs font-medium text-amber-800">
                <span data-mode-notice="delivered">{t.products.tableNotice}</span>
                <span data-mode-notice="exw" class="hidden">{t.products.tableNoticeExw}</span>
              </p>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[820px] border-collapse text-sm">
                  <thead>
                    <tr class="bg-primary-900 text-white">
                      <th class="px-4 py-3 text-left font-semibold whitespace-nowrap">{t.products.tableSize}</th>
                      <th class="px-4 py-2.5 text-left font-semibold">
                        <div class="flex items-center gap-2">
                          <span class="whitespace-nowrap">{t.products.tableMaterial}</span>
                          <button
                            type="button"
                            class="material-trigger inline-flex max-w-[240px] items-center gap-1 truncate rounded-md border border-white/40 px-2 py-0.5 text-xs font-semibold transition hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-white"
                            aria-expanded="false"
                            aria-haspopup="dialog"
                          >
                            <span class="material-value truncate">{materialLabel(type.code.length)}</span>
                            <span aria-hidden="true">▾</span>
                          </button>
                        </div>
                      </th>
                      {pricing.tiers.map(tier => (
                        <th class="px-4 py-3 text-right font-semibold whitespace-nowrap">{tier.zh}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {type.rows.map((row, i) => (
                      <tr data-dims={row.dims.join(',')} class={i % 2 === 1 ? 'bg-gray-50' : ''}>
                        <td class="px-4 py-3 font-medium text-primary-800 whitespace-nowrap">{row.size}</td>
                        <td class="material-cell px-4 py-3 text-gray-600">{materialLabel(type.code.length)}</td>
                        {pricing.tiers.map(tier => (
                          <td class="price-cell px-4 py-3 text-right font-semibold text-gray-800 whitespace-nowrap" data-qty={tier.qty}>
                            {formatPrice(priceFor(type.code, row.dims, tier.qty, defaultMode), currency)}
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}

          <p class="mt-4 text-xs text-gray-500">{t.products.pricingNote}</p>

          <!-- 材料选择浮层 -->
          <div
            id="material-panel"
            class="fixed z-50 hidden w-80 rounded-xl border border-gray-200 bg-white p-4 shadow-2xl"
            role="dialog"
            aria-label={t.products.tableMaterial}
          >
            <p class="mb-2 text-xs font-semibold text-gray-600">{t.products.materialPresetsLabel}</p>
            <div id="material-presets" class="mb-4 flex flex-col gap-2"></div>
            <p class="mb-1 text-xs font-semibold text-gray-600">{t.products.materialCustomLabel}</p>
            <label class="mb-1 block text-[11px] text-gray-500">{t.products.linerLabel}</label>
            <select id="liner-select" class="mb-2 w-full rounded-lg border-gray-300 px-3 py-1.5 text-sm"></select>
            <label class="mb-1 block text-[11px] text-gray-500">{t.products.mediumLabel}</label>
            <select id="medium-select" class="w-full rounded-lg border-gray-300 px-3 py-1.5 text-sm"></select>
            <p id="material-error" class="mt-2 hidden text-xs text-red-600">{t.products.materialInvalid}</p>
            <div class="mt-3 flex justify-end gap-2">
              <button type="button" id="material-cancel" class="rounded-lg px-3 py-1.5 text-xs font-semibold text-gray-600 transition hover:bg-gray-100">
                {t.products.materialCancel}
              </button>
              <button type="button" id="material-apply" class="rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-accent-700">
                {t.products.materialApply}
              </button>
            </div>
          </div>
        </div>
      )}

      <!-- 7 层：暂无 E/B/C 组合 -->
      {pricing && pricing.types.length === 0 && (
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center">
          <p class="text-gray-600">{t.products.sevenLayerQuoteOnly}</p>
        </div>
      )}

      <!-- 应用场景 + 定制选项 -->
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{t.products.detailApplications}</h3>
          <ul class="space-y-2">
            {data.applications.map(app => (
              <li class="flex items-start gap-2 text-gray-600"><span class="text-accent-600 mt-1">•</span> {app}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{t.products.detailCustomOptions}</h3>
          <ul class="space-y-2">
            {data.customOptions.map(opt => (
              <li class="flex items-start gap-2 text-gray-600"><span class="text-accent-600 mt-1">•</span> {opt}</li>
            ))}
          </ul>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <a id="product-quote-cta" href={`${quoteUrl}&shipping=need`} class="inline-block rounded-lg bg-accent-600 px-8 py-3.5 font-semibold text-white transition hover:bg-accent-700">
          {t.products.detailRequestQuote} →
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<script type="application/json" id="pricing-data" set:html={JSON.stringify({
  lang: LANG,
  layerCount,
  currency,
  defaultMode,
  defaultMaterial: { liner: defaultLinerId, medium: defaultMediumId },
  params,
  tiers: pricing?.tiers ?? [],
  presets,
  materials: { liners, mediums, boardProcessing, smallOrder },
  types: pricing?.types ?? [],
})} />

<script>
  import { pricePerPiece, formatPrice } from '@utils/boxPricing';

  const dataEl = document.getElementById('pricing-data');
  const root = document.getElementById('pricing-root');
  if (dataEl && root) {
    const data = JSON.parse(dataEl.textContent || '{}');
    const lang: string = data.lang || 'zh';
    let mode: string = data.defaultMode || 'delivered';
    let linerId: string = data.defaultMaterial?.liner ?? data.presets[0]?.liner ?? data.materials.liners[0].id;
    let mediumId: string = data.defaultMaterial?.medium ?? data.presets[0]?.medium ?? data.materials.mediums[0].id;

    const panel = document.getElementById('material-panel');
    const presetsBox = document.getElementById('material-presets');
    const linerSel = document.getElementById('liner-select') as HTMLSelectElement | null;
    const mediumSel = document.getElementById('medium-select') as HTMLSelectElement | null;
    const errorEl = document.getElementById('material-error');
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('.material-trigger'));
    const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.mode-btn'));

    const nameOf = (item: any) => (lang === 'zh' ? item.zh : item.en);
    const linerOf = (id: string) => data.materials.liners.find((l: any) => l.id === id);
    const mediumOf = (id: string) => data.materials.mediums.find((m: any) => m.id === id);

    function labelFor(fluteCount: number): string {
      const liner = linerOf(linerId);
      const medium = mediumOf(mediumId);
      if (!liner || !medium) return '';
      return `${nameOf(liner)} × ${fluteCount + 1} + ${nameOf(medium)}`;
    }

    function canPrice(): boolean {
      const medium = mediumOf(mediumId);
      if (!medium) return false;
      return (data.types as any[]).every(t =>
        String(t.code).split('').every(f => medium.prices[f] !== undefined)
      );
    }

    function render() {
      const liner = linerOf(linerId);
      const medium = mediumOf(mediumId);
      if (!liner || !medium) return;
      const processing = data.materials.boardProcessing[data.layerCount] ?? 0.28;

      root!.querySelectorAll<HTMLElement>('[data-type]').forEach(block => {
        const code = block.dataset.type || '';
        const label = labelFor(code.length);
        block.querySelectorAll<HTMLElement>('.material-value').forEach(el => { el.textContent = label; });
        block.querySelectorAll<HTMLElement>('.material-cell').forEach(el => { el.textContent = label; });
        block.querySelectorAll<HTMLTableRowElement>('tr[data-dims]').forEach(tr => {
          const dims = (tr.dataset.dims || '').split(',').map(Number);
          tr.querySelectorAll<HTMLTableCellElement>('.price-cell').forEach(td => {
            const qty = Number(td.dataset.qty);
            const value = pricePerPiece({
              dims,
              typeCode: code,
              layerCount: data.layerCount,
              linerPrice: liner.price,
              mediumPrices: medium.prices,
              processing,
              smallOrder: data.materials.smallOrder,
              qty,
              mode: mode as any,
              params: data.params,
            });
            td.textContent = formatPrice(value, data.currency);
          });
        });
      });

      document.querySelectorAll<HTMLElement>('[data-mode-notice]').forEach(el => {
        el.classList.toggle('hidden', el.dataset.modeNotice !== mode);
      });

      modeBtns.forEach(btn => {
        const active = btn.dataset.modeBtn === mode;
        btn.classList.toggle('bg-accent-600', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('bg-white', !active);
        btn.classList.toggle('text-gray-700', !active);
      });

      presetsBox?.querySelectorAll<HTMLButtonElement>('button').forEach(btn => {
        const active = btn.dataset.liner === linerId && btn.dataset.medium === mediumId;
        btn.classList.toggle('border-accent-600', active);
        btn.classList.toggle('bg-accent-50', active);
        btn.classList.toggle('border-gray-300', !active);
        btn.classList.toggle('bg-white', !active);
      });

      const cta = document.getElementById('product-quote-cta') as HTMLAnchorElement | null;
      if (cta) {
        const url = new URL(cta.href);
        url.searchParams.set('shipping', mode === 'exw' ? 'own-forwarder' : 'need');
        cta.href = url.toString();
      }
    }

    (data.presets as any[]).forEach(p => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.dataset.liner = p.liner;
      btn.dataset.medium = p.medium;
      btn.textContent = nameOf(p);
      btn.className = 'rounded-lg border px-3 py-2 text-left text-xs font-semibold transition';
      btn.addEventListener('click', () => {
        linerId = p.liner;
        mediumId = p.medium;
        render();
        closePanel();
      });
      presetsBox?.appendChild(btn);
    });

    (data.materials.liners as any[]).forEach(l => {
      const opt = document.createElement('option');
      opt.value = l.id;
      opt.textContent = `${nameOf(l)}`;
      linerSel?.appendChild(opt);
    });
    (data.materials.mediums as any[]).forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = `${nameOf(m)}`;
      mediumSel?.appendChild(opt);
    });

    function openPanel(trigger: HTMLButtonElement) {
      if (!panel) return;
      panel.classList.remove('hidden');
      errorEl?.classList.add('hidden');
      if (linerSel) linerSel.value = linerId;
      if (mediumSel) mediumSel.value = mediumId;
      const rect = trigger.getBoundingClientRect();
      const pw = panel.offsetWidth || 320;
      const ph = panel.offsetHeight || 320;
      const left = Math.max(12, Math.min(rect.left, window.innerWidth - pw - 12));
      let top = rect.bottom + 8;
      if (top + ph > window.innerHeight - 12) top = Math.max(12, rect.top - ph - 8);
      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closePanel() {
      panel?.classList.add('hidden');
      triggers.forEach(tr => tr.setAttribute('aria-expanded', 'false'));
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        openPanel(btn);
      });
    });

    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        mode = btn.dataset.modeBtn || 'delivered';
        render();
      });
    });

    document.getElementById('material-apply')?.addEventListener('click', () => {
      const nextLiner = linerSel?.value ?? linerId;
      const nextMedium = mediumSel?.value ?? mediumId;
      const prevLiner = linerId;
      const prevMedium = mediumId;
      linerId = nextLiner;
      mediumId = nextMedium;
      if (!canPrice()) {
        linerId = prevLiner;
        mediumId = prevMedium;
        errorEl?.classList.remove('hidden');
        return;
      }
      render();
      closePanel();
    });

    document.getElementById('material-cancel')?.addEventListener('click', closePanel);

    document.addEventListener('click', e => {
      if (!panel || panel.classList.contains('hidden')) return;
      const target = e.target as Node;
      if (panel.contains(target) || triggers.some(tr => tr.contains(target))) return;
      closePanel();
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') closePanel();
    });

    window.addEventListener('resize', closePanel);

    render();
  }
</script>
