---
// Hidden dev utility: a floating wrench button.
// Click it 10 times (within 3s between clicks) to reveal a change-log panel.
// Notes are persisted in the browser's localStorage under `qianxi-change-notes`.
---

<button
  id="mod-notes-wrench"
  type="button"
  aria-label="修改记录"
  title="修改记录"
  class="fixed bottom-6 right-6 z-[60] flex h-12 w-12 items-center justify-center rounded-full bg-primary-900/75 text-white shadow-lg backdrop-blur transition hover:scale-105 hover:bg-primary-800"
>
  <svg
    class="h-6 w-6"
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
  </svg>
</button>

<div
  id="mod-notes-panel"
  class="fixed bottom-24 right-6 z-[70] hidden w-[min(92vw,380px)] overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl"
>
  <div class="flex items-center justify-between bg-primary-900 px-4 py-3 text-white">
    <span class="text-sm font-bold" style="font-family: var(--font-heading);">修改记录</span>
    <button id="mod-notes-close" type="button" aria-label="关闭" class="text-white/70 transition hover:text-white">✕</button>
  </div>
  <div class="p-4">
    <textarea
      id="mod-notes-input"
      rows="3"
      placeholder="记录需要修改的内容，例如：把首页标题改成…"
      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-primary-500"
    ></textarea>
    <div class="mt-2 flex flex-wrap gap-2">
      <button id="mod-notes-save" type="button" class="rounded-lg bg-accent-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-accent-700">保存</button>
      <button id="mod-notes-copy" type="button" class="rounded-lg bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:bg-gray-200">复制全部</button>
      <button id="mod-notes-clear" type="button" class="rounded-lg bg-gray-100 px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:bg-gray-200">清空</button>
    </div>
    <ul id="mod-notes-list" class="mt-3 max-h-64 space-y-2 overflow-auto"></ul>
  </div>
</div>

<script>
  interface Note {
    id: number;
    text: string;
    ts: number;
  }

  const STORAGE_KEY = 'qianxi-change-notes';
  const CLICKS_REQUIRED = 10;
  const RESET_MS = 3000;

  const wrench = document.getElementById('mod-notes-wrench') as HTMLButtonElement;
  const panel = document.getElementById('mod-notes-panel') as HTMLDivElement;
  const closeBtn = document.getElementById('mod-notes-close') as HTMLButtonElement;
  const input = document.getElementById('mod-notes-input') as HTMLTextAreaElement;
  const saveBtn = document.getElementById('mod-notes-save') as HTMLButtonElement;
  const copyBtn = document.getElementById('mod-notes-copy') as HTMLButtonElement;
  const clearBtn = document.getElementById('mod-notes-clear') as HTMLButtonElement;
  const list = document.getElementById('mod-notes-list') as HTMLUListElement;

  function loadNotes(): Note[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? (JSON.parse(raw) as Note[]) : [];
    } catch {
      return [];
    }
  }

  function persist(notes: Note[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(notes));
    } catch {
      /* storage unavailable */
    }
  }

  function formatTime(ts: number): string {
    const d = new Date(ts);
    const p = (n: number) => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
  }

  function render() {
    const notes = loadNotes();
    list.innerHTML = '';
    if (notes.length === 0) {
      const li = document.createElement('li');
      li.className = 'px-2 py-3 text-center text-xs text-gray-400';
      li.textContent = '暂无记录';
      list.appendChild(li);
      return;
    }
    notes
      .slice()
      .reverse()
      .forEach(n => {
        const li = document.createElement('li');
        li.className = 'flex items-start justify-between gap-2 rounded-lg bg-gray-50 px-3 py-2';

        const body = document.createElement('div');
        const time = document.createElement('p');
        time.className = 'text-xs text-gray-400';
        time.textContent = formatTime(n.ts);
        const text = document.createElement('p');
        text.className = 'text-sm whitespace-pre-wrap break-words text-gray-800';
        text.textContent = n.text;
        body.appendChild(time);
        body.appendChild(text);

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'shrink-0 text-xs text-red-500 transition hover:text-red-700';
        del.textContent = '删除';
        del.addEventListener('click', () => {
          persist(loadNotes().filter(x => x.id !== n.id));
          render();
        });

        li.appendChild(body);
        li.appendChild(del);
        list.appendChild(li);
      });
  }

  function openPanel() {
    panel.classList.remove('hidden');
    input.focus();
  }

  // 10-click trigger with a reset window
  let clickCount = 0;
  let clickTimer: number | undefined;
  wrench.addEventListener('click', () => {
    clickCount += 1;
    window.clearTimeout(clickTimer);
    clickTimer = window.setTimeout(() => {
      clickCount = 0;
    }, RESET_MS);
    if (clickCount >= CLICKS_REQUIRED) {
      clickCount = 0;
      window.clearTimeout(clickTimer);
      openPanel();
    }
  });

  closeBtn.addEventListener('click', () => panel.classList.add('hidden'));

  saveBtn.addEventListener('click', () => {
    const text = input.value.trim();
    if (!text) return;
    const notes = loadNotes();
    notes.push({ id: Date.now(), text, ts: Date.now() });
    persist(notes);
    input.value = '';
    render();
  });

  copyBtn.addEventListener('click', async () => {
    const notes = loadNotes();
    if (notes.length === 0) return;
    const text = notes.map(n => `[${formatTime(n.ts)}] ${n.text}`).join('\n');
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // fallback for older browsers
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    copyBtn.textContent = '已复制 ✓';
    window.setTimeout(() => {
      copyBtn.textContent = '复制全部';
    }, 1500);
  });

  clearBtn.addEventListener('click', () => {
    if (window.confirm('确定清空所有修改记录？')) {
      persist([]);
      render();
    }
  });

  render();
</script>
