---
interface Props {
  lang?: string;
  variant?: 'compact' | 'featured';
}
const { lang = 'en', variant = 'compact' } = Astro.props;
const isZh = lang === 'zh';

const title = isZh ? 'FSC® 认证材料' : 'FSC® Certified Material';
const desc = isZh
  ? '可提供 FSC Mix 与 FSC Recycled 认证瓦楞纸包装，原料来自 FSC® 认证的可持续林业供应链。'
  : 'Corrugated packaging available with FSC Mix and FSC Recycled certification, using paper from FSC®-certified sustainable forestry supply chains.';

const facts = [
  { k: isZh ? '证书代码' : 'Certificate', v: 'BV-COC-193172 · No. CN045813/2' },
  { k: isZh ? '标准' : 'Standard', v: 'FSC-STD-40-004 · Chain of Custody' },
  { k: isZh ? '认证机构' : 'Certified by', v: 'Bureau Veritas' },
  { k: isZh ? '有效期至' : 'Valid until', v: isZh ? '2028-09-06' : '06 Sep 2028' },
];
const source = isZh
  ? '认证纸板供应商：玖龙环球包装（东莞）有限公司'
  : 'Certified board supplied by Nine Dragons Worldwide (Dongguan) Packaging Co., Ltd.';
---

{/* Generic leaf mark (not the FSC trademark logo) */}
{
  variant === 'compact' ? (
    <section class="border-y border-green-100 bg-green-50/70">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-5 px-4 py-8 text-center sm:flex-row sm:text-left">
        <svg viewBox="0 0 24 24" class="h-11 w-11 shrink-0 text-green-600" aria-hidden="true">
          <path d="M4 20C4 11 9 4 20 4c0 11-5 16-16 16Z" fill="currentColor" />
          <path d="M4 20c2.5-1.5 5-4 6.5-7" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <div class="flex-1">
          <p class="text-base font-bold text-green-800" style="font-family: var(--font-heading);">{title}</p>
          <p class="mt-1 text-sm text-gray-600">{desc}</p>
        </div>
        <div class="flex shrink-0 gap-2">
          <span class="rounded-full bg-green-600 px-3 py-1 text-xs font-semibold text-white">FSC Mix</span>
          <span class="rounded-full bg-green-600 px-3 py-1 text-xs font-semibold text-white">FSC Recycled</span>
        </div>
      </div>
    </section>
  ) : (
    <div class="rounded-xl border border-green-200 bg-green-50/60 p-8">
      <div class="grid items-start gap-6 lg:grid-cols-2">
        <div>
          <div class="flex items-center gap-3">
            <svg viewBox="0 0 24 24" class="h-10 w-10 text-green-600" aria-hidden="true">
              <path d="M4 20C4 11 9 4 20 4c0 11-5 16-16 16Z" fill="currentColor" />
              <path d="M4 20c2.5-1.5 5-4 6.5-7" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <h3 class="text-xl font-bold text-green-900" style="font-family: var(--font-heading);">{title}</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-gray-700">{desc}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <span class="rounded-full bg-green-600 px-3 py-1 text-xs font-semibold text-white">FSC Mix</span>
            <span class="rounded-full bg-green-600 px-3 py-1 text-xs font-semibold text-white">FSC Recycled</span>
          </div>
        </div>
        <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-2">
          {facts.map(f => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">{f.k}</dt>
              <dd class="mt-0.5 text-gray-800">{f.v}</dd>
            </div>
          ))}
          <div class="sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">{isZh ? '材料来源' : 'Source'}</dt>
            <dd class="mt-0.5 text-gray-500">{source}</dd>
          </div>
        </dl>
      </div>
    </div>
  )
}
