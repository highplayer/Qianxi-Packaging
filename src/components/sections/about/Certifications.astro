---
import type { SiteTranslations } from '@/i18n/types';
import FscCert from '@components/sections/misc/FscCert.astro';
const { t, lang = 'en' } = Astro.props;
interface Props { t: SiteTranslations; lang?: string; }

const secondary = [
  { title: t.about.certISO, desc: t.about.certISODesc },
  { title: t.about.certSGS, desc: t.about.certSGSDesc },
  { title: t.about.certREACH, desc: t.about.certREACHDesc },
];
---

<section class="py-20">
  <div class="mx-auto max-w-7xl px-4">
    <h2 class="mb-10 text-center text-3xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
      {t.about.certificationsTitle}
    </h2>

    <FscCert lang={lang} variant="featured" />

    <div class="mt-6 grid gap-6 sm:grid-cols-3">
      {secondary.map(c => (
        <div class="rounded-xl border border-gray-200 bg-white p-6 text-center">
          <svg viewBox="0 0 24 24" class="mx-auto mb-4 h-10 w-10 text-primary-600" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" />
            <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h3 class="text-lg font-bold text-primary-800" style="font-family: var(--font-heading);">{c.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{c.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
