---
import { Image, getImage } from 'astro:assets';
import companyIntroImg from '@images/CompanyIntro.png';
import type { SiteTranslations } from '@/i18n/types';
import type { ImageMetadata } from 'astro';
const { t, lang = 'en' } = Astro.props;
interface Props { t: SiteTranslations; lang?: string; }
const isZh = lang === 'zh';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'zh' ? '/zh' : '';

// Auto-scan machine photos dropped into src/images/equipment/
// (files are sorted by name; the first one shows as the main image)
const equipmentModules = import.meta.glob('/src/images/equipment/printer-slotter/*.{jpg,jpeg,png,avif,webp}', {
  eager: true,
  import: 'default',
}) as unknown as Record<string, ImageMetadata>;
const equipmentPhotos = Object.entries(equipmentModules)
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([, img]) => img);

// Precompute optimized versions (small thumbs + large mains) so we don't load 2MB PNGs
const equipmentMains: ImageMetadata[] = [];
const equipmentThumbs: ImageMetadata[] = [];
for (const img of equipmentPhotos) {
  equipmentThumbs.push(await getImage({ src: img, width: 160, format: 'avif', quality: 65 }));
  equipmentMains.push(await getImage({ src: img, width: 1000, format: 'avif', quality: 80 }));
}
---

<section class="py-20">
  <div class="mx-auto max-w-7xl px-4">
    <!-- Intro Row -->
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <div>
        <h1 class="mb-6 text-4xl font-extrabold leading-tight text-primary-900 md:text-5xl" style="font-family: var(--font-heading);">
          {t.about.introHeading}
        </h1>
        <p class="mb-8 text-lg leading-relaxed text-gray-600">
          {t.about.introText}
        </p>
        <ul class="mb-8 space-y-3">
          {[
            t.about.introHighlight1,
            t.about.introHighlight2,
            t.about.introHighlight3,
          ].map(item => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-600 text-xs font-bold text-white">✓</span>
              <span class="text-gray-700">{item}</span>
            </li>
          ))}
        </ul>
        <a href={`${base}${prefix}/quote`} class="inline-block rounded-lg bg-accent-600 px-8 py-3 font-semibold text-white transition hover:bg-accent-700">
          {t.nav.getQuote} →
        </a>
      </div>
      <Image
        src={companyIntroImg}
        alt={isZh ? '成都芊西包装材料有限公司工厂外观' : 'Qianxi Packaging factory exterior'}
        class="h-80 w-full rounded-xl object-cover lg:h-[420px]"
        format="avif"
      />
    </div>

    <!-- Factory Details: Production Layout + Equipment -->
    <div class="mt-16 grid gap-8 lg:grid-cols-2">
      <!-- Production Layout -->
      <div class="rounded-xl border border-gray-200 bg-white p-8">
        <h3 class="mb-4 text-xl font-bold text-primary-800" style="font-family: var(--font-heading);">
          {isZh ? '生产线布局' : 'Production Layout'}
        </h3>
        <p class="mb-6 text-sm text-gray-600 leading-relaxed">
          {isZh
            ? '本项目主要在已建厂房基础上进行生产线布置和设备安装，不涉及土建工程。生产区位于车间北侧，自北向南依次布置：'
            : 'Production line layout and equipment installation within an existing factory building (no civil works). The production area occupies the north side of the workshop, arranged north to south:'}
        </p>
        <div class="grid grid-cols-2 gap-3 text-sm">
          {[
            ['印刷区', 'Printing Zone'],
            ['堆码区', 'Stacking Zone'],
            ['组装区', 'Assembly Zone'],
            ['打包区', 'Packing Zone'],
          ].map(([zh, en]) => (
            <div class="rounded-lg bg-gray-100 px-4 py-3 font-medium text-primary-800">{isZh ? zh : en}</div>
          ))}
        </div>
        <div class="mt-6 grid gap-3 text-sm">
          {[
            { zh: '原材料库 200 m²（北侧）', en: 'Raw Materials: 200 m² (North)' },
            { zh: '半成品区 80 m² + 预存区 100 m²（中部）', en: 'Semi-finished: 80 m² + Pre-storage: 100 m² (Central)' },
            { zh: '成品区 200 m²（南侧）', en: 'Finished Products: 200 m² (South)' },
            { zh: '辅料库 100 m²（东侧中部，储存白乳胶/油墨，重点防渗）', en: 'Auxiliary Storage: 100 m² (East-central, latex/ink, impermeable)' },
            { zh: '办公室 60 m² + 卫生间（东侧）', en: 'Office 60 m² + Restroom (East)' },
          ].map(item => (
            <div class="flex items-start gap-2">
              <span class="mt-0.5 text-accent-600">•</span>
              <span class="text-gray-600">{isZh ? item.zh : item.en}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Equipment + Environmental -->
      <div class="space-y-8">
        <!-- Equipment -->
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-xl font-bold text-primary-800" style="font-family: var(--font-heading);">
            {isZh ? '主要生产设备' : 'Main Equipment'}
          </h3>
          {equipmentPhotos.length > 0 && (
            <div class="mb-6">
              <p class="mb-2 text-xs font-medium text-gray-500">
                {isZh
                  ? '高速四色印刷模切开槽机（1228型）实拍'
                  : 'High-Speed 4-Color Printer Slotter (Model 1228) — Live Photos'}
              </p>
              <img
                id="equipment-main-img"
                src={equipmentMains[0].src}
                alt={isZh ? '高速四色印刷模切开槽机' : 'High-Speed 4-Color Printer Slotter'}
                class="h-52 w-full rounded-lg object-cover"
                loading="lazy"
              />
              {equipmentPhotos.length > 1 && (
                <div class="mt-2 flex gap-2">
                  {equipmentPhotos.map((photo, i) => (
                    <button
                      type="button"
                      class={`equipment-thumb flex-1 overflow-hidden rounded-md border-2 transition hover:opacity-80 ${
                        i === 0 ? 'border-accent-600' : 'border-transparent'
                      }`}
                      data-src={equipmentMains[i].src}
                      aria-label={isZh ? `查看第 ${i + 1} 张照片` : `View photo ${i + 1}`}
                    >
                      <img src={equipmentThumbs[i].src} alt="" class="h-14 w-full object-cover" loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
          <div class="space-y-3 text-sm">
            {[
              { zh: '高速四色印刷模切开槽机（1228型）× 1', en: 'High-Speed 4-Color Printer Slotter (Model 1228) × 1' },
              { zh: '全自动粘钉一体机（2800型）× 1', en: 'Auto Gluer-Stitcher (Model 2800) × 1' },
              { zh: '堆码机（1228型）× 1', en: 'Stacker (Model 1228) × 1' },
              { zh: '全自动结束带打包机（1400型）× 1', en: 'Auto Strapping Machine (Model 1400) × 1' },
              { zh: '地牛叉车（3T）× 5', en: 'Pallet Jacks (3T) × 5' },
              { zh: '螺杆空压机（15kW）× 1', en: 'Screw Air Compressor (15kW) × 1' },
              { zh: '一体化污水处理装置（1T）× 1', en: 'Integrated Wastewater Treatment (1T) × 1' },
            ].map(item => (
              <div class="flex items-start gap-2">
                <span class="mt-0.5 text-accent-600">•</span>
                <span class="text-gray-600">{isZh ? item.zh : item.en}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Environmental -->
        <div class="rounded-xl border border-gray-200 bg-white p-8">
          <h3 class="mb-4 text-xl font-bold text-primary-800" style="font-family: var(--font-heading);">
            {isZh ? '环保合规' : 'Environmental Compliance'}
          </h3>
          <div class="space-y-3 text-sm">
            <div class="flex items-start gap-2">
              <span class="mt-0.5 text-accent-600">•</span>
              <span class="text-gray-600">{isZh ? '一般固废暂存区 10 m²，危废暂存间 5 m²（重点防渗）' : 'General waste 10 m² + Hazardous waste room 5 m² (impermeable)'}</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="mt-0.5 text-accent-600">•</span>
              <span class="text-gray-600">{isZh ? '隔油池 0.5 m³ + 一体化废水处理系统 1 m³/天（印刷废水处理后回用）' : 'Oil separator 0.5 m³ + Integrated wastewater treatment 1 m³/day (printing water recycled)'}</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="mt-0.5 text-accent-600">•</span>
              <span class="text-gray-600">{isZh ? '印刷/粘箱废气：集气罩 + 二级活性炭 + 15m排气筒（DA001）' : 'Printing/gluing exhaust: Hoods + 2-stage activated carbon + 15m stack (DA001)'}</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="mt-0.5 text-accent-600">•</span>
              <span class="text-gray-600">{isZh ? '供水、供电及雨污管网依托园区既有设施' : 'Water, power, drainage via existing park infrastructure'}</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="mt-0.5 text-accent-600">•</span>
              <span class="text-gray-600">{isZh ? '危废间和辅料库为新建重点防渗区，其余依托现有硬化地面' : 'Hazardous waste & aux materials zones: new impermeable; other areas: existing hardened flooring'}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Utility Info Line -->
    <p class="mt-8 text-center text-xs text-gray-400">
      {isZh
        ? '施工期主要影响：装修噪声、颗粒物及废包装材料。运营期主要影响：生产噪声、废边角料、危险废物、有机废气、粉尘、生活污水及清洗废水。'
        : 'Construction phase: renovation noise, particulates, waste packaging. Operation phase: production noise, scrap, hazardous waste, organic exhaust, dust, domestic/cleaning wastewater.'}
    </p>
  </div>
</section>

<script>
  // Click a thumbnail to swap the main machine photo
  const mainImg = document.getElementById('equipment-main-img') as HTMLImageElement | null;
  const thumbs = document.querySelectorAll<HTMLButtonElement>('.equipment-thumb');
  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.getAttribute('data-src');
      if (src && mainImg) mainImg.src = src;
      thumbs.forEach((t) => {
        t.classList.remove('border-accent-600');
        t.classList.add('border-transparent');
      });
      thumb.classList.remove('border-transparent');
      thumb.classList.add('border-accent-600');
    });
  });
</script>
