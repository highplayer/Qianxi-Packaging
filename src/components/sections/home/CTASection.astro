---
import type { SiteTranslations } from '@/i18n/types';
const { t, lang = 'en' } = Astro.props;
interface Props { t: SiteTranslations; lang?: string; }
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = lang === 'zh' ? '/zh' : '';
const quoteUrl = `${base}${prefix}/quote`;
---

<section class="py-20">
  <div class="mx-auto max-w-4xl rounded-2xl bg-primary-900 px-6 py-16 text-center text-white">
    <h2 class="mb-4 text-3xl font-extrabold" style="font-family: var(--font-heading);">{t.home.ctaTitle}</h2>
    <p class="mb-8 text-gray-300">{t.home.ctaSubtitle}</p>
    <form id="homepage-cta-form" class="mx-auto flex max-w-xl flex-wrap justify-center gap-3" data-quote-url={quoteUrl}>
      <input type="email" name="email" required placeholder={t.home.ctaEmailPlaceholder}
        class="flex-1 min-w-[200px] rounded-lg border-0 px-4 py-3 text-gray-900" />
      <input type="text" name="name" placeholder={t.home.ctaNamePlaceholder}
        class="flex-1 min-w-[150px] rounded-lg border-0 px-4 py-3 text-gray-900" />
      <input type="text" name="requirements" placeholder={t.home.ctaRequirementsPlaceholder}
        class="w-full rounded-lg border-0 px-4 py-3 text-gray-900" />
      <button type="submit" class="rounded-lg bg-accent-600 px-8 py-3 font-semibold transition hover:bg-accent-700">
        {t.home.ctaButton} →
      </button>
    </form>
    <p class="mt-4 text-xs text-gray-400">Protected by reCAPTCHA. We respect your privacy.</p>
  </div>
</section>

<script>
  // Send the visitor to the quote page, carrying the name / email / requirements they typed.
  const form = document.getElementById('homepage-cta-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const target = form.getAttribute('data-quote-url') || '/quote';
    const data = new FormData(form);
    const params = new URLSearchParams();
    const email = (data.get('email') || '').toString().trim();
    const name = (data.get('name') || '').toString().trim();
    const requirements = (data.get('requirements') || '').toString().trim();
    if (email) params.set('email', email);
    if (name) params.set('name', name);
    if (requirements) params.set('message', requirements);
    const qs = params.toString();
    window.location.href = qs ? `${target}?${qs}` : target;
  });
</script>
