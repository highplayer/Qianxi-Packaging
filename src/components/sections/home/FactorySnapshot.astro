---
import { Image } from 'astro:assets';
import type { SiteTranslations } from '@/i18n/types';
import linePrinterSlotter from '@images/equipment/printer-slotter/01-front.png';
import lineGluerStitcher from '@images/equipment/gluer-stitcher/01.png';
import folderGluer from '@images/equipment/gzpx-3000/01.png';
import qcLab from '@images/equipment/quality-lab/01.jpg';
import warehouseImg from '@images/equipment/warehouse.png';
import finishedImg from '@images/equipment/finished-project.png';

const { t, lang = 'en' } = Astro.props;
interface Props { t: SiteTranslations; lang?: string; }
const isZh = lang === 'zh';

const shots = [
  { img: linePrinterSlotter, zh: '印刷开槽模切流水线', en: 'Printer Slotter Line', pos: '' },
  { img: lineGluerStitcher, zh: '糊盒钉箱流水线', en: 'Gluer-Stitcher Line', pos: '' },
  { img: folderGluer, zh: '全自动粘箱机 GZPX-3000', en: 'Automatic Folder Gluer GZPX-3000', pos: '' },
  // Portrait shot: the machine's working parts sit in the lower part of the frame
  { img: qcLab, zh: '质检实验室', en: 'QC Laboratory', pos: 'object-bottom' },
];

const sideShots = [
  { img: warehouseImg, zh: '成品仓库', en: 'Warehouse' },
  { img: finishedImg, zh: '印刷成品', en: 'Finished Products' },
];
---

<section class="py-20">
  <div class="mx-auto max-w-7xl px-4">
    <h2 class="mb-12 text-center text-3xl font-extrabold text-primary-900" style="font-family: var(--font-heading);">
      {t.home.factorySnapshotTitle}
    </h2>
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div class="grid grid-cols-2 gap-4">
          {shots.map(shot => (
            <figure class="overflow-hidden rounded-lg bg-white shadow-sm">
              <Image
                src={shot.img}
                alt={isZh ? shot.zh : shot.en}
                width={640}
                format="avif"
                class={`h-40 w-full object-cover ${shot.pos}`}
              />
              <figcaption class="px-3 py-2 text-xs font-medium text-gray-600">
                {isZh ? shot.zh : shot.en}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="grid gap-4">
        {sideShots.map(shot => (
          <figure class="overflow-hidden rounded-lg bg-white shadow-sm">
            <Image
              src={shot.img}
              alt={isZh ? shot.zh : shot.en}
              width={640}
              format="avif"
              class="h-40 w-full object-cover"
            />
            <figcaption class="px-3 py-2 text-xs font-medium text-gray-600">
              {isZh ? shot.zh : shot.en}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
